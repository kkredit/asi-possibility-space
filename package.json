{
  "name": "ai-safety-possibility-explorer",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Interactively explore the AI-safety possibility space: tweak credences, see expected outcomes, find the max-EV action.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
